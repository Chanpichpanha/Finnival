# =========================================================
# Finnival Server Environment Variables (.env)
# Copy this file to `.env` inside `/server` (or add in Render/Railway dashboard).
# Do NOT commit your real `.env` file!
# =========================================================

# 1. Google Gemini (Free tier at https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional model override
# GEMINI_MODEL=gemini-3.8-flash

# 2. Groq Cloud Fallback (Free tier at https://console.groq.com/)
GROQ_API_KEY=

# Optional model override
# GROQ_MODEL=openai/gpt-oss-120b

# 3. Local Ollama Fallback (Offline local machine only)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 4. Clerk Authentication (Free tier at https://clerk.com/)
# Leave blank for local open mode; set BOTH keys to enable user accounts & private quiz libraries.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 5. PostgreSQL Database (Free tier at https://neon.tech/ or https://supabase.com/)
# Leave blank for local JSON file storage (`server/data/question-sets.json`).
DATABASE_URL=

# 6. Production / Deployment Settings
# Comma-separated frontend URLs allowed by CORS (e.g. https://finnival.vercel.app)
CLIENT_ORIGIN=
# PORT=3001
# SERVE_CLIENT=false
