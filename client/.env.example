# =========================================================
# Finnival Client Environment Variables (.env / .env.local)
# Copy to `client/.env.local` for local testing or set in Vercel Dashboard.
# =========================================================

# Backend Server URL (leave blank locally to use same host port 3001; set to your Render/Railway URL in Vercel)
REACT_APP_SERVER_URL=

# Clerk Publishable Key (pk_test_... or pk_live_... from https://dashboard.clerk.com/)
# Leave blank to run without sign-in prompts locally.
REACT_APP_CLERK_PUBLISHABLE_KEY=
